# Copy to .env on the SERVER only. Never commit .env. Generate secrets yourself:
#   PHONEPE_KEK : openssl rand -base64 32
#   JWT_SECRET  : openssl rand -base64 48   (only until KIRO's real login replaces src/auth.js)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/kiro
PHONEPE_KEK=
JWT_SECRET=
PUBLIC_BASE_URL=https://api.your-domain.example
# Take both from PhonePe's merchant documentation for your account (UAT first):
PHONEPE_BASE_URL=
PHONEPE_QR_PATH=/v3/qr/init
QR_EXPIRY_SECONDS=600
MAX_BILL_PAISE=10000000
NODE_ENV=production

# Only if you host the admin app as a website: exact web address(es) allowed to call the API, comma separated.
# Leave empty if you only use the phone app.
CORS_ORIGINS=

# KIRO AI wording (optional). Without these KIRO AI still answers, using the calculated text.
# Free providers that speak the OpenAI format work: Groq (default URL below), or point AI_BASE_URL at another provider.
# Get the key from the provider's console yourself; keep it on the server only.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_HOURLY_LIMIT=30
AI_DAILY_LIMIT=800

# Nightly 10 PM owner report on WhatsApp (optional). Uses the WhatsApp Business Cloud API (Meta). Get all three from your Meta
# Business account yourself; the server never sends without them. The template must be approved by Meta first:
#   category Utility, one body variable, e.g.  "Your KIRO daily report: {{1}}"
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE=
WA_TEMPLATE_LANG=en
WA_GRAPH_VERSION=v21.0
# The report wording uses the same AI_API_KEY / AI_MODEL as KIRO AI above; without them the calculated text is sent.
