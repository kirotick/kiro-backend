{
  "name": "kiro-backend-api",
  "version": "1.0.0",
  "private": true,
  "description": "KIRO core API: auth, staff, items, stock, sales, reports, Ask KIRO, nightly owner report. Payments are in kiro-payments; database schema in kiro-database.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:db": "node --env-file=.env.test --test --test-concurrency=1 \"test/*.test.js\"",
    "migrate": "node scripts/migrate.js",
    "migrate:local": "node --env-file=.env scripts/migrate.js",
    "users": "node scripts/users.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "pg": "^8.13.0"
  }
}