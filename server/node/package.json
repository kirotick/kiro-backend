    "db:info": "node --env-file=.env scripts/db-info.js",
    "users": "node scripts/users.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "pg": "^8.13.0"
  }
