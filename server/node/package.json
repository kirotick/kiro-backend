{
  "name": "kiro-payments-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "test:db": "node --env-file=../../qa/.env --test --test-concurrency=1 \"test/*.test.js\"",
